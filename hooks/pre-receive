#!/bin/sh
# Copyright (c) 2026 Alessio Attilio and the litzy contributors
#
# Server-side enforcement of R30 and R31. Install this hook in the bare
# repository that acts as the remote. See docs/repository-security.md.

set -eu

zero=0000000000000000000000000000000000000000

fail() {
  echo "rejected: $*" >&2
  exit 1
}

while read -r oldrev newrev refname; do
  case "$refname" in
    refs/heads/main)
      [ "$newrev" != "$zero" ] || fail "main cannot be deleted"
      if [ "$oldrev" = "$zero" ]; then
        parent_count=$(git rev-list --parents -n 1 "$newrev" | awk '{ print NF - 1 }')
        [ "$parent_count" -eq 0 ] || fail "the first main commit must be the empty root"
        [ -z "$(git ls-tree -r --name-only "$newrev")" ] || fail "the first main commit must carry no content"
        continue
      fi
      parent_count=$(git rev-list --parents -n 1 "$newrev" | awk '{ print NF - 1 }')
      [ "$parent_count" -eq 2 ] || fail "main accepts only two-parent pull request merges"
      first_parent=$(git rev-parse "${newrev}^1")
      [ "$first_parent" = "$oldrev" ] || fail "the merge must be onto the current main"
      subject=$(git show -s --format=%s "$newrev")
      printf '%s\n' "$subject" | grep -q '^Merge pull request #[0-9][0-9]* from pr/' ||
        fail "the merge subject must name the pull request branch"
      ;;
    refs/heads/pr/*)
      [ "$newrev" != "$zero" ] || continue
      ;;
    refs/tags/v*)
      [ "$newrev" != "$zero" ] || fail "version tags cannot be deleted"
      ;;
    *)
      fail "only main, pr/* and version tags are accepted: $refname"
      ;;
  esac

  for commit in $(git rev-list "$newrev" --not --all); do
    if git show -s --format=%B "$commit" | grep -qiE 'Co-Authored-By:.*(Mistral Vibe|vibe@mistral|opencode|open.?code|claude|copilot|codex|agent|assistant|automation)'; then
      fail "commit $commit names an agent as a co-author, forbidden by R30"
    fi
  done
done

exit 0
