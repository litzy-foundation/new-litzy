# Copyright (c) 2026 Alessio Attilio and the litzy contributors
# Documented environment variables. Only placeholders appear here.
# The real .env file is git-ignored and stays on the local machine.

# Local database and profile
LITZY_PROFILE_DIR=./.litzy-local
LITZY_DB_NAME=litzy.db
LITZY_DB_PASSPHRASE=replace-with-a-local-secret

# IMAP vacuum, Mode B
LITZY_IMAP_HOST=imap.example.invalid
LITZY_IMAP_PORT=993
LITZY_IMAP_USER=replace-with-your-address
LITZY_IMAP_PASSWORD=replace-with-your-password
LITZY_IMAP_FOLDER=Litzy/Ingested
LITZY_IMAP_PURGE_OPT_IN=false

# Authenticated SMTP outbound
LITZY_SMTP_HOST=smtp.example.invalid
LITZY_SMTP_PORT=587
LITZY_SMTP_USER=replace-with-your-address
LITZY_SMTP_PASSWORD=replace-with-your-password

# Optional local pipe transport
LITZY_SENDMAIL_PATH=/usr/sbin/sendmail

# Engine diagnostics
LITZY_LOG_LEVEL=info
